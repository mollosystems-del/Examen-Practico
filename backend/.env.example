PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DB_SERVER=localhost
# Vacío usa el protocolo local de Windows; para TCP especifica 1433 u otro puerto.
DB_PORT=
DB_NAME=FarmaInventario
# windows: autenticación integrada con msnodesqlv8 (Windows + ODBC Driver 18).
# sql: usuario/contraseña; compatible con Linux y Docker.
DB_AUTH=windows
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=true
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Opcional para una instancia nombrada (p. ej. SQLEXPRESS). No usar DB_PORT a la vez.
DB_INSTANCE=
JWT_SECRET=
ADMIN_EMAIL=admin@farma.local
ADMIN_PASSWORD=Farma2026!
